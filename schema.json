{
  "_readme": "Maps Notion column names (right) to dashboard fields (left). If you rename a property in Notion, change it here only. dateOrder is used for numeric dates like 10/26/2026: MDY or DMY.",
  "dateOrder": "MDY",
  "files": {
    "trades": ["data/trades.csv", "data/sample/trades.csv"],
    "accounts": ["data/accounts.csv", "data/sample/accounts.csv"]
  },
  "trades": {
    "id": "ID",
    "title": "Trade",
    "mode": "Mode",
    "model": "Model",
    "version": "Model version",
    "account": "Account",
    "instrument": "Instrument",
    "date": "Date",
    "dow": "Day of week",
    "entryTime": "Entry time",
    "exitTime": "Exit time",
    "session": "Session",
    "killZone": "Kill zone",
    "macro": "Macro window",
    "direction": "Direction",
    "bias": "HTF bias",
    "biasTf": "Bias timeframe",
    "setupTf": "Setup timeframe",
    "entryTf": "Entry timeframe",
    "dailyProfile": "Daily profile",
    "asiaRange": "Asia range",
    "liquidity": "Liquidity taken",
    "confluences": "Confluences",
    "pdArray": "PD array of entry",
    "premDisc": "Premium/Discount",
    "news": "News day",
    "plannedRR": "Planned RR",
    "result": "Result",
    "r": "R multiple",
    "risk": "Risk ($)",
    "mae": "MAE (R)",
    "mfe": "MFE (R)",
    "exitReason": "Exit reason",
    "taken": "Taken",
    "followed": "Followed plan",
    "loggedBefore": "Logged before outcome",
    "grade": "Setup grade",
    "confidence": "Confidence (1-5)",
    "emoBefore": "Emotion before",
    "emoDuring": "Emotion during",
    "emoAfter": "Emotion after",
    "mistakes": "Mistakes",
    "shotBefore": "Screenshot before",
    "shotAfter": "Screenshot after",
    "notes": "Notes"
  },
  "required": ["mode", "model", "instrument", "date", "session", "direction", "result", "r"],
  "allowed": {
    "mode": ["Backtest", "Paper", "Live"],
    "instrument": ["NQ", "ES", "MNQ", "MES"],
    "session": ["Asia", "London", "NY AM", "NY Lunch", "NY PM"],
    "direction": ["Long", "Short"],
    "result": ["Win", "Loss", "Breakeven"]
  },
  "accounts": {
    "name": "Name",
    "type": "Type",
    "size": "Account size",
    "risk": "Risk per trade",
    "target": "Profit target",
    "dailyLoss": "Daily loss limit",
    "maxDD": "Max drawdown",
    "ddType": "Drawdown type",
    "minDays": "Min trading days"
  }
}
